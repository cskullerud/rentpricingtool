# Copy to .env and adjust. Everything has a default, so nothing here is required.
# Load it with: uvicorn app.main:app --reload --env-file .env
APP_NAME=Rent Pricing Tool
VERSION=0.1.0
ENVIRONMENT=development

# SQLite file for valuation history (default: data/rentpricingtool.db in the project)
# DATABASE_PATH=data/rentpricingtool.db

# Where comparables come from: mock (default), rentcast or csv.
# csv is a placeholder for now and raises NotImplementedError.
# DATA_PROVIDER=mock

# RentCast provider (DATA_PROVIDER=rentcast). The key is required; the rest are optional.
# Every uncached valuation costs one RentCast request, so results are cached per area.
# RENTCAST_API_KEY=
# RENTCAST_RADIUS_MILES=5           # search radius, 0.1-100
# RENTCAST_LIMIT=100                # listings per request, 1-500
# RENTCAST_TIMEOUT_SECONDS=10
# RENTCAST_CACHE_TTL_SECONDS=86400  # 0 turns the cache off
# RENTCAST_MAX_RETRIES=1            # extra tries after a 429, 5xx or network failure, 0-3
# RENTCAST_RETRY_DELAY_SECONDS=0.5  # doubles after each retry

# Fewest comparables a valuation may be based on (after filtering and outlier removal).
# Below this the API answers 404 with status "insufficient_data". Whole number, at least 1.
# MIN_COMPARABLES_REQUIRED=3

# Key for the web UI's CSRF tokens. Optional: if unset, a random key is made at each start, and
# a form left open across a restart is asked to be submitted again.
# UI_SECRET_KEY=

# Development only. Inside the Home Assistant app this is set automatically to the Supervisor
# (172.30.32.2). When set, only connections from these addresses are answered; leave it unset
# when running locally.
# ALLOWED_PEERS=172.30.32.2

# Address lookup (address -> latitude/longitude). mock (default) knows only a few demo addresses;
# census uses the free US Census geocoder (US addresses, no key). Answers are cached in the
# database. The Home Assistant app defaults to census.
# GEOCODER=mock
# GEOCODE_CACHE_TTL_SECONDS=7776000      # 90 days; 0 turns the cache off
# GEOCODE_NOT_FOUND_TTL_SECONDS=86400    # how long "not found" is remembered; 0 = not remembered
# GEOCODER_TIMEOUT_SECONDS=10
# GEOCODER_MAX_RETRIES=1                 # extra tries when the service is busy or unreachable
# GEOCODER_RETRY_DELAY_SECONDS=0.5
