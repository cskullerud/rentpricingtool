# Copy to .env and adjust. Everything has a default, so nothing here is required.
# Load it with: uvicorn app.main:app --reload --env-file .env
APP_NAME=Rent Pricing Tool
VERSION=0.1.0
ENVIRONMENT=development

# SQLite file for valuation history (default: data/rentpricingtool.db in the project)
# DATABASE_PATH=data/rentpricingtool.db

# Where comparables come from: mock (default), rentcast or csv.
# csv is a placeholder for now and raises NotImplementedError.
# DATA_PROVIDER=mock

# RentCast provider (DATA_PROVIDER=rentcast). The key is required; the rest are optional.
# Every uncached valuation costs one RentCast request, so results are cached per area.
# RENTCAST_API_KEY=
# RENTCAST_RADIUS_MILES=5           # search radius, 0.1-100
# RENTCAST_LIMIT=100                # listings per request, 1-500
# RENTCAST_TIMEOUT_SECONDS=10
# RENTCAST_CACHE_TTL_SECONDS=86400  # 0 turns the cache off
